# Required: get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model used to generate answers. Swap to claude-sonnet-4-5 for higher quality.
CLINICALRAG_MODEL=claude-haiku-4-5

# Comma-separated frontend origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000

# Retrieval tuning.
CLINICALRAG_TOP_K=5
CLINICALRAG_MIN_SIMILARITY=0.35
