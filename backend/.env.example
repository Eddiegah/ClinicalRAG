# Required: get a free key (no credit card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used to generate answers. Swap to gemini-2.5-flash for higher quality
# (still on the free tier, just lower rate limits).
CLINICALRAG_MODEL=gemini-flash-lite-latest

# Comma-separated frontend origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000

# Retrieval tuning.
CLINICALRAG_TOP_K=5
CLINICALRAG_MIN_SIMILARITY=0.5
